{
    "name": "anixapp",
    "version": "0.1.52",
    "description": "Быстрый клиент для просмотра аниме на базе Anixart API",
    "repository": "github:Maks1mio/anixapp",
    "main": "electron/main.js",
    "scripts": {
        "install:no-esbuild-postinstall": "cross-env ESBUILD_SKIP_POSTINSTALL=1 yarn install",
        "dev": "vite",
        "build:icon": "node scripts/build-icon.js",
        "build": "vite build && yarn build:icon && node scripts/inject-oauth-env.js && electron-builder --publish=never",
        "build:win": "vite build && yarn build:icon && node scripts/inject-oauth-env.js && electron-builder --win --publish=never",
        "build:linux-deb": "vite build && yarn build:icon && node scripts/inject-oauth-env.js && electron-builder --linux deb --publish=never",
        "build:linux-arch": "vite build && yarn build:icon && node scripts/inject-oauth-env.js && electron-builder --linux pacman --publish=never",
        "build:linux-appimage": "vite build && yarn build:icon && node scripts/inject-oauth-env.js && electron-builder --linux AppImage --publish=never",
        "build:vite": "vite build",
        "electron:build": "vite build && yarn build:icon && node scripts/inject-oauth-env.js && electron-builder --publish=never",
        "rebuild:native": "electron-rebuild -f -w discord_bridge",
        "electron:dev": "concurrently \"vite\" \"wait-on http://127.0.0.1:5173 && cross-env NODE_ENV=development electron .\"",
        "preview": "vite preview"
    },
    "keywords": [
        "anime",
        "anixart",
        "electron"
    ],
    "author": "",
    "license": "MIT",
    "devDependencies": {
        "@electron/rebuild": "^4.2.0",
        "@sveltejs/vite-plugin-svelte": "^7.3.0",
        "concurrently": "^10.0.5",
        "cross-env": "^10.1.0",
        "electron": "43.4.0",
        "electron-builder": "^26.15.3",
        "png2icons": "^2.0.1",
        "sass": "^1.102.0",
        "svelte": "^5.56.9",
        "svelte-check": "^4.7.6",
        "typescript": "^7.0.2",
        "vite": "^8.2.1",
        "wait-on": "^9.1.0"
    },
    "dependencies": {
        "@xhayper/discord-rpc": "^1.3.1",
        "anime4k-webgpu": "^1.0.0",
        "anixapi": "0.3.2",
        "ffmpeg-static": "^5.3.0",
        "flag-icons": "^7.5.0",
        "gsap": "^3.15.0",
        "hls.js": "^1.7.0",
        "html-to-image": "^1.11.13",
        "lottie-web": "^5.13.0",
        "lucide": "^1.31.0"
    },
    "resolutions": {
        "axios": "^1.18.0",
        "follow-redirects": "^1.16.0",
        "postcss": "^8.5.25",
        "@xmldom/xmldom": "^0.8.13",
        "ws": "^8.21.0",
        "tmp": "^0.2.7",
        "form-data": "^4.0.6",
        "tar": "^7.5.22",
        "undici": "7.29.0",
        "ip-address": "^10.2.0",
        "shell-quote": "1.10.0",
        "js-yaml": "^4.3.0",
        "immutable": "^5.1.9",
        "fast-uri": "^3.1.4",
        "brace-expansion": "^5.0.8",
        "minimatch/brace-expansion": "1.1.16"
    },
    "build": {
        "appId": "com.anixapp.client",
        "productName": "AnixApp",
        "directories": {
            "output": "release"
        },
        "files": [
            "dist/**/*",
            "electron/**/*",
            "public/logo/**/*"
        ],
        "asarUnpack": [
            "**/node_modules/ffmpeg-static/**"
        ],
        "icon": "public/logo/512x512.png",
        "protocols": [
            {
                "name": "Anixart",
                "schemes": [
                    "anixart"
                ]
            }
        ],
        "win": {
            "icon": "public/logo/icon.ico"
        },
        "linux": {
            "target": [
                "deb",
                "pacman",
                "AppImage"
            ],
            "icon": "public/logo",
            "category": "Network",
            "maintainer": "Maks1mio",
            "executableName": "anixapp"
        },
        "deb": {
            "depends": [
                "libgtk-3-0",
                "libnotify4",
                "libnss3",
                "libxss1",
                "libxtst6",
                "xdg-utils",
                "libatspi2.0-0",
                "libsecret-1-0"
            ]
        },
        "pacman": {
            "artifactName": "${name}_${version}_${arch}.pkg.tar.zst"
        }
    }
}
