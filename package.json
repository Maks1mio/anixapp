{
  "name": "anixapp",
  "version": "0.1.4",
  "description": "Быстрый клиент для просмотра аниме на базе Anixart API",
  "main": "electron/main.js",
  "scripts": {
    "install:no-esbuild-postinstall": "cross-env ESBUILD_SKIP_POSTINSTALL=1 yarn install",
    "dev": "vite",
    "build:icon": "node scripts/build-icon.js",
    "build": "vite build && yarn build:icon && electron-builder",
    "build:win": "vite build && yarn build:icon && electron-builder --win",
    "build:linux-deb": "vite build && yarn build:icon && electron-builder --linux deb",
    "build:linux-arch": "vite build && yarn build:icon && electron-builder --linux pacman",
    "build:vite": "vite build",
    "rebuild:native": "electron-rebuild -f -w discord_bridge",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
    "electron:build": "vite build && yarn build:icon && electron-builder",
    "preview": "vite preview"
  },
  "keywords": [
    "anime",
    "anixart",
    "electron"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^35.7.5",
    "electron-builder": "^26.8.1",
    "sass": "^1.77.8",
    "to-ico": "^1.1.5",
    "vite": "^6.0.3",
    "wait-on": "^8.0.1"
  },
  "dependencies": {
    "@xhayper/discord-rpc": "^1.3.1",
    "anixartjs": "^0.1.6",
    "hls.js": "^1.6.15",
    "lucide": "^0.577.0"
  },
  "build": {
    "appId": "com.anixapp.client",
    "productName": "AnixApp",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/logo/**/*"
    ],
    "icon": "public/logo/512x512.png",
    "win": {
      "icon": "public/logo/icon.ico"
    },
    "linux": {
      "target": [
        "deb",
        "pacman"
      ],
      "icon": "public/logo",
      "category": "Network",
      "maintainer": "Maks1mio",
      "executableName": "anixapp",
      "desktop": {
        "Name": "AnixApp",
        "Comment": "Быстрый клиент для просмотра аниме",
        "Terminal": "false",
        "Categories": "Network;AudioVideo;"
      }
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libsecret-1-0"
      ]
    }
  }
}
