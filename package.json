{
    "name": "anixapp",
    "desktopName": "anixapp.desktop",
    "version": "0.1.63",
    "description": "Быстрый клиент для просмотра аниме на базе Anixart API",
    "repository": "github:Maks1mio/anixapp",
    "main": "electron/main.js",
    "scripts": {
        "install:no-esbuild-postinstall": "cross-env ESBUILD_SKIP_POSTINSTALL=1 yarn install",
        "dev": "vite",
        "build:icon": "node scripts/build-icon.js",
        "build:sounds": "node scripts/generate-notification-sounds.js",
        "build": "vite build && npm run build:icon && node scripts/inject-oauth-env.js && electron-builder --publish=never",
        "build:win": "vite build && npm run build:icon && node scripts/inject-oauth-env.js && electron-builder --win --publish=never",
        "build:mac": "vite build && npm run build:icon && node scripts/inject-oauth-env.js && electron-builder --mac --publish=never",
        "build:linux-deb": "node scripts/ensure-linux-host.mjs deb && vite build && npm run build:icon && node scripts/inject-oauth-env.js && electron-builder --linux deb --publish=never",
        "build:linux-arch": "node scripts/ensure-linux-host.mjs pacman && vite build && npm run build:icon && node scripts/inject-oauth-env.js && electron-builder --linux pacman --publish=never",
        "build:linux-appimage": "node scripts/ensure-linux-host.mjs AppImage && vite build && npm run build:icon && node scripts/inject-oauth-env.js && electron-builder --linux AppImage --publish=never",
        "build:vite": "vite build",
        "build:ads-embed": "node scripts/build-ads-embed.mjs",
        "electron:build": "vite build && npm run build:icon && node scripts/inject-oauth-env.js && electron-builder --publish=never",
        "rebuild:native": "electron-rebuild -f",
        "electron:dev": "concurrently \"vite\" \"wait-on http://127.0.0.1:5173 && cross-env NODE_ENV=development electron .\"",
        "electron:dev-prev": "concurrently -k \"cross-env ANIXAPP_DEV_PORT=5175 vite\" \"wait-on http://127.0.0.1:5175 && cross-env NODE_ENV=development ANIXAPP_DEV_PREV=1 ANIXAPP_DEV_PORT=5175 electron .\"",
        "dev:tv":"cross-env VITE_TV_MODE=1 ANIXAPP_DEV_PORT=5174 vite",
        "electron:dev-tv": "concurrently -k \"cross-env VITE_TV_MODE=1 ANIXAPP_DEV_PORT=5174 vite\" \"wait-on http://127.0.0.1:5174 && cross-env NODE_ENV=development ANIXAPP_TV=1 ANIXAPP_DEV_PORT=5174 electron .\"",
        "build:tv:vite": "cross-env VITE_TV_MODE=1 vite build",
        "build:tv:web": "cross-env VITE_TV_MODE=1 ANIXAPP_OUT_DIR=dist-tv-web ANIXAPP_WEB_BASE=/ vite build",
        "tv:bridge": "node scripts/tv-bridge-server.mjs",
        "deploy:tv": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-tv-to-server.ps1",
        "build:android-tv": "node scripts/build-android-tv.mjs",
        "build:android-mobile": "node scripts/build-android-mobile.mjs",
        "emu:tv:setup": "node scripts/setup-android-tv-emu.mjs",
        "emu:tv": "node scripts/run-android-tv-emu.mjs",
        "live": "node scripts/live.mjs",
        "preview": "vite preview",
        "postinstall": "node scripts/ensure-eslint-typescript.js",
        "check:mojibake": "node scripts/check-mojibake.js",
        "fix:mojibake": "node scripts/check-mojibake.js --fix",
        "lint": "eslint . && stylelint \"src/**/*.{scss,css}\" \"src/**/*.svelte\" && npm run check:mojibake",
        "lint:eslint": "eslint .",
        "lint:electron": "eslint electron",
        "lint:scss": "stylelint \"src/**/*.{scss,css}\" \"src/**/*.svelte\"",
        "lint:fix": "eslint . --fix && stylelint \"src/**/*.{scss,css}\" \"src/**/*.svelte\" --fix",
        "check": "svelte-check --tsconfig ./tsconfig.json && npm run lint"
    },
    "keywords": [
        "anime",
        "anixart",
        "electron"
    ],
    "author": "",
    "license": "PolyForm-Noncommercial-1.0.0",
    "devDependencies": {
        "@capacitor/android": "^8.5.2",
        "@capacitor/cli": "^8.5.2",
        "@electron/rebuild": "^4.2.0",
        "@eslint/compat": "^1.4.1",
        "@eslint/js": "^9.39.2",
        "@sveltejs/vite-plugin-svelte": "^7.3.1",
        "@typescript-eslint/eslint-plugin": "^8.50.1",
        "@typescript-eslint/parser": "^8.50.1",
        "concurrently": "^10.0.5",
        "cross-env": "^10.1.0",
        "electron": "44.10.0",
        "electron-builder": "^26.15.3",
        "esbuild": "^0.28.2",
        "eslint": "^9.39.2",
        "eslint-plugin-svelte": "^3.13.1",
        "globals": "^16.5.0",
        "png2icons": "^2.0.1",
        "postcss-html": "^1.8.0",
        "sass": "^1.105.1",
        "stylelint": "^16.25.0",
        "stylelint-config-recommended-scss": "^14.1.0",
        "svelte": "^5.57.1",
        "svelte-check": "^4.7.6",
        "typescript": "^7.0.2",
        "vite": "^8.3.3",
        "wait-on": "^9.5.1"
    },
    "dependencies": {
        "@capacitor/app": "^8.1.2",
        "@capacitor/core": "^8.5.3",
        "@eneris/push-receiver": "4.4.0",
        "@xhayper/discord-rpc": "^1.5.1",
        "anime4k-webgpu": "^1.0.0",
        "anixapi": "0.4.0",
        "binauralfir": "0.1.2",
        "ffmpeg-static": "^5.3.0",
        "flag-icons": "^7.6.0",
        "gsap": "^3.15.0",
        "hls.js": "^1.7.3",
        "html-to-image": "^1.11.13",
        "lottie-web": "^5.13.0",
        "lucide": "^1.61.0"
    },
    "resolutions": {
        "axios": "^1.18.0",
        "minimatch": "^10.0.3",
        "follow-redirects": "^1.16.1",
        "postcss": "^8.5.25",
        "@xmldom/xmldom": "^0.8.15",
        "ws": "^8.21.0",
        "tmp": "^0.2.7",
        "form-data": "^4.0.6",
        "tar": "^7.5.22",
        "undici": "7.30.1",
        "ip-address": "^10.7.4",
        "shell-quote": "^1.11.0",
        "http-cache-semantics": "^4.3.0",
        "js-yaml": "^4.3.2",
        "joi": "^18.2.9",
        "immutable": "^5.1.9",
        "fast-uri": "^3.1.9",
        "brace-expansion": "^5.0.12",
        "minimatch/brace-expansion": "1.1.21",
        "uuid": "^11.1.1"
    },
    "build": {
        "appId": "com.anixapp.client",
        "productName": "AnixApp",
        "directories": {
            "output": "release"
        },
        "files": [
            "dist/**/*",
            "electron/**/*",
            "public/logo/**/*"
        ],
        "asarUnpack": [
            "**/node_modules/ffmpeg-static/**"
        ],
        "icon": "public/logo/512x512.png",
        "protocols": [
            {
                "name": "Anixart",
                "schemes": [
                    "anixart"
                ]
            }
        ],
        "win": {
            "icon": "public/logo/icon.ico"
        },
        "mac": {
            "icon": "public/logo/icon-mac.png",
            "category": "public.app-category.entertainment",
            "target": [
                "dmg"
            ],
            "identity": "-",
            "hardenedRuntime": false,
            "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
        },
        "linux": {
            "target": [
                "deb",
                "pacman",
                "AppImage"
            ],
            "icon": "public/logo",
            "category": "Network",
            "maintainer": "Maks1mio",
            "executableName": "anixapp",
            "syncDesktopName": true
        },
        "deb": {
            "depends": [
                "libgtk-3-0",
                "libnotify4",
                "libnss3",
                "libxss1",
                "libxtst6",
                "xdg-utils",
                "libatspi2.0-0",
                "libsecret-1-0"
            ]
        },
        "pacman": {
            "artifactName": "${name}_${version}_${arch}.pkg.tar.zst"
        }
    }
}
